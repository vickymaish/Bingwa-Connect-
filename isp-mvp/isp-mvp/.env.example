# Copy this file to .env and fill it in.  NEVER commit .env to GitHub.
# Leave the Daraja values empty to run in DEMO mode (payments are simulated).

PORT=3000

# --- Daraja (use credentials from the SAME app) ---
DARAJA_ENV=sandbox
DARAJA_KEY=
DARAJA_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=174379
# Paybill = CustomerPayBillOnline (default). Till number = CustomerBuyGoodsOnline
DARAJA_TXN_TYPE=CustomerPayBillOnline
# Only needed for till numbers, where the store/till number differs from the shortcode
# DARAJA_PARTYB=

# Public HTTPS address of this server (e.g. your ngrok URL). Daraja cannot call localhost.
PUBLIC_URL=

# Any long random string. It becomes part of the callback URL so strangers cannot fake payments.
CALLBACK_SECRET=change-this-to-something-random
